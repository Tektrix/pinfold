{
  "manifest_version": 3,
  "name": "Pinfold - Private Tab Manager",
  "short_name": "Pinfold",
  "version": "1.0.1",
  "description": "Local-only tab manager. Save open tabs into folders to free memory, search them, export to OneTab, Markdown or JSON. No tracking.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Pinfold - Tab Manager"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "favicon"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "commands": {
    "send_all_tabs": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "windows": "Alt+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Collapse all tabs in window into Pinfold"
    },
    "send_current_tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "windows": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Send current active tab to Pinfold"
    },
    "open_dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "windows": "Alt+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open Pinfold Dashboard"
    }
  }
}